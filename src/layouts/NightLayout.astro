---
import '@fontsource/unbounded/600.css';
import '@fontsource/unbounded/700.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/600.css';
import '../styles/night/tokens.css';
import '../styles/night/night.css';
import { getT, locales, localizePath, type Locale, type PageId } from '../i18n/config';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = getT(locale);

const site = Astro.site ?? new URL('https://innviertel-express.at');
const absolute = (l: Locale) => new URL(localizePath(l, page), site).href;

const ogLocales: Record<Locale, string> = { de: 'de_AT', en: 'en_US', ru: 'ru_RU', uk: 'uk_UA' };

// Hint bar data: each locale's "also available" line, written in its own language.
const hintData = Object.fromEntries(
  locales.map((l) => {
    const lt = getT(l);
    return [
      l,
      {
        text: lt('common.hintAvailable'),
        open: lt('common.hintOpen'),
        dismiss: lt('common.hintDismiss'),
        href: localizePath(l, page),
      },
    ];
  })
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e13" />
    {/* TODO(client): remove once this design replaces the one at /. Until then the
        comparison route must not compete with the live page in search results. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(`new.meta.title`)}</title>
    <meta name="description" content={t(`new.meta.description`)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={absolute(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('de')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('common.brand')} />
    <meta property="og:title" content={t(`new.meta.title`)} />
    <meta property="og:description" content={t(`new.meta.description`)} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t('common.skipToContent')}</a>
    <div
      id="locale-hint"
      class="locale-hint"
      hidden
      data-current-locale={locale}
      data-hints={JSON.stringify(hintData)}
    >
      <p class="locale-hint-text"></p>
      <a class="locale-hint-open" href="#"></a>
      <button class="locale-hint-dismiss" type="button"></button>
    </div>
    <slot />

    <script>
      // Persist explicit language choices; never auto-redirect.
      const CHOICE_KEY = 'ie-locale';
      const DISMISS_KEY = 'ie-locale-hint-dismissed';

      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest?.('[data-locale-choice]');
        if (link) localStorage.setItem(CHOICE_KEY, link.getAttribute('data-locale-choice') ?? '');
      });

      const hint = document.getElementById('locale-hint');
      if (hint && !localStorage.getItem(CHOICE_KEY) && !localStorage.getItem(DISMISS_KEY)) {
        const current = hint.dataset.currentLocale;
        const hints = JSON.parse(hint.dataset.hints ?? '{}');
        const browser = (navigator.language || '').slice(0, 2).toLowerCase();
        if (browser !== current && hints[browser]) {
          const data = hints[browser];
          hint.querySelector('.locale-hint-text')!.textContent = data.text;
          const open = hint.querySelector('.locale-hint-open') as HTMLAnchorElement;
          open.textContent = data.open;
          open.href = data.href;
          open.setAttribute('data-locale-choice', browser);
          const dismiss = hint.querySelector('.locale-hint-dismiss') as HTMLButtonElement;
          dismiss.textContent = data.dismiss;
          dismiss.addEventListener('click', () => {
            localStorage.setItem(DISMISS_KEY, '1');
            hint.hidden = true;
          });
          hint.hidden = false;
        }
      }
    </script>

    <script>
      /* THE LIGHT — the whole JS budget for the signature effect.
         One listener writes --beam-x / --beam-y (viewport px) onto <html>; every
         .lit surface picks them up through background-attachment: fixed, so the
         cards need no script of their own.

         The hero is the exception. It needs mask coordinates local to itself and
         mask-attachment is not reliably supported, so it gets its own --hero-x /
         --hero-y derived from a cached rect. Two mechanics, one visible light. */
      const root = document.documentElement;
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const hero = document.querySelector<HTMLElement>('[data-hero-light]');

      let heroRect: DOMRect | null = null;
      const measure = () => {
        heroRect = hero?.getBoundingClientRect() ?? null;
      };
      measure();
      window.addEventListener('resize', measure);
      window.addEventListener('scroll', measure, { passive: true });

      const setHero = (x: string, y: string) => {
        hero?.style.setProperty('--hero-x', x);
        hero?.style.setProperty('--hero-y', y);
      };

      let pointerTookOver = false;

      // Page-load moment: the light starts at the van's headlight and sweeps
      // across to the driver, then rests on him. Skipped under reduced motion,
      // and abandoned the instant the visitor moves the pointer.
      //
      // Deliberately expressed in percentages: the figure's height is not final
      // until the hero image has decoded, so a sweep computed from an early rect
      // aims at the wrong part of the photograph.
      if (hero && !reduce.matches) {
        const from = { x: 82, y: 58 };
        const to = { x: 34, y: 47 };
        const DURATION = 1150;
        let start = 0;

        const step = (now: number) => {
          if (pointerTookOver) return;
          if (!start) start = now;
          const p = Math.min(1, (now - start) / DURATION);
          const e = 1 - Math.pow(1 - p, 3); // easeOutCubic
          setHero(`${from.x + (to.x - from.x) * e}%`, `${from.y + (to.y - from.y) * e}%`);
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      if (fine.matches && !reduce.matches) {
        let px = 0;
        let py = 0;
        let queued = false;

        document.addEventListener(
          'pointermove',
          (event) => {
            px = event.clientX;
            py = event.clientY;
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              pointerTookOver = true;
              root.style.setProperty('--beam-x', `${px}px`);
              root.style.setProperty('--beam-y', `${py}px`);
              if (heroRect) setHero(`${px - heroRect.left}px`, `${py - heroRect.top}px`);
            });
          },
          { passive: true }
        );
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--hi);
        color: var(--night-0);
        padding: var(--space-2) var(--space-3);
        z-index: var(--z-hint);
        font-weight: 600;
      }

      .skip-link:focus-visible {
        left: 0;
      }

      .locale-hint {
        position: sticky;
        top: 0;
        z-index: var(--z-hint);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        padding: var(--space-2) var(--space-4);
        background: var(--night-2);
        border-bottom: 1px solid var(--edge);
        color: var(--body);
        font-size: var(--text-small);
      }

      .locale-hint[hidden] {
        display: none;
      }

      .locale-hint-text {
        margin: 0;
      }

      .locale-hint-open {
        color: var(--hi);
        font-weight: 600;
      }

      .locale-hint-dismiss {
        margin-inline-start: auto;
        background: none;
        border: 1px solid var(--edge);
        border-radius: var(--radius-s);
        color: inherit;
        padding: var(--space-1) var(--space-2);
        min-height: var(--touch-target);
      }
    </style>
  </body>
</html>
