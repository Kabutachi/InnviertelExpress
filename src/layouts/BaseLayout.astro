---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { getT, getRaw, langTags, locales, localizePath, businessAddress, vatId, phoneE164, type Locale, type PageId } from '../i18n/config';

interface Props {
  locale: Locale;
  page: PageId;
  noindex?: boolean;
}

const { locale, page, noindex = false } = Astro.props;
const t = getT(locale);
const metaPage = getRaw(locale, `meta.${page}`) ? page : 'home';

const site = Astro.site ?? new URL('https://innviertel-express.at');
const absolute = (l: Locale) => new URL(localizePath(l, page), site).href;

const ogLocales: Record<Locale, string> = { de: 'de_AT', en: 'en_US', ru: 'ru_RU', ua: 'uk_UA' };
const ogImage = new URL(`/og/og-${locale}.jpg`, site).href;
const title = t(`meta.${metaPage}.title`);
const description = t(`meta.${metaPage}.description`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', site).href,
  name: t('common.brand'),
  legalName: 'Innviertel Express e.U.',
  description,
  url: absolute(locale),
  image: ogImage,
  logo: new URL('/apple-touch-icon.png', site).href,
  telephone: phoneE164(locale),
  email: t('common.email'),
  vatID: vatId,
  address: { '@type': 'PostalAddress', ...businessAddress },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Innviertel' },
    { '@type': 'State', name: 'Oberösterreich' },
    { '@type': 'State', name: 'Salzburg' },
    { '@type': 'State', name: 'Bayern' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  knowsLanguage: locales.map((l) => langTags[l]),
};

// Hint bar data: each locale's "also available" line, written in its own language.
const hintData = Object.fromEntries(
  locales.map((l) => {
    const lt = getT(l);
    return [l, { text: lt('common.hintAvailable'), open: lt('common.hintOpen'), dismiss: lt('common.hintDismiss'), href: localizePath(l, page) }];
  })
);
---

<!doctype html>
<html lang={langTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2ea" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={absolute(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={langTags[l]} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('de')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('common.brand')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('home.hero.photoAlt')} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('common.skipToContent')}</a>
    <div
      id="locale-hint"
      class="locale-hint"
      hidden
      data-current-locale={locale}
      data-hints={JSON.stringify(hintData)}
    >
      <p class="locale-hint-text"></p>
      <a class="locale-hint-open" href="#"></a>
      <button class="locale-hint-dismiss" type="button"></button>
    </div>
    <slot />

    <script>
      // Persist explicit language choices; never auto-redirect.
      const CHOICE_KEY = 'ie-locale';
      const DISMISS_KEY = 'ie-locale-hint-dismissed';

      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest?.('[data-locale-choice]');
        if (link) localStorage.setItem(CHOICE_KEY, link.getAttribute('data-locale-choice') ?? '');
      });

      const hint = document.getElementById('locale-hint');
      if (hint && !localStorage.getItem(CHOICE_KEY) && !localStorage.getItem(DISMISS_KEY)) {
        const current = hint.dataset.currentLocale;
        const hints = JSON.parse(hint.dataset.hints ?? '{}');
        const lang = (navigator.language || '').slice(0, 2).toLowerCase();
        const browser = lang === 'uk' ? 'ua' : lang;
        if (browser !== current && hints[browser]) {
          const data = hints[browser];
          hint.querySelector('.locale-hint-text')!.textContent = data.text;
          const open = hint.querySelector('.locale-hint-open') as HTMLAnchorElement;
          open.textContent = data.open;
          open.href = data.href;
          open.setAttribute('data-locale-choice', browser);
          const dismiss = hint.querySelector('.locale-hint-dismiss') as HTMLButtonElement;
          dismiss.textContent = data.dismiss;
          dismiss.addEventListener('click', () => {
            localStorage.setItem(DISMISS_KEY, '1');
            hint.hidden = true;
          });
          hint.hidden = false;
        }
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--color-ink);
        color: var(--color-bg);
        padding: var(--space-2) var(--space-3);
        z-index: var(--z-hint);
      }

      .skip-link:focus-visible {
        left: 0;
      }

      .locale-hint {
        position: sticky;
        top: 0;
        z-index: var(--z-hint);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        padding: var(--space-2) var(--space-4);
        background: var(--color-ink);
        color: var(--color-bg);
        /* System font: the hint is usually in another script and must not pull extra webfont subsets. */
        font-family: system-ui, sans-serif;
        font-size: var(--text-small);
      }

      .locale-hint[hidden] {
        display: none;
      }

      .locale-hint-text {
        margin: 0;
        opacity: 1;
      }

      .locale-hint-open {
        color: inherit;
        font-weight: 600;
        min-height: auto;
      }

      .locale-hint-dismiss {
        margin-inline-start: auto;
        background: none;
        border: 1px solid color-mix(in srgb, var(--color-bg) 40%, transparent);
        border-radius: var(--radius-s);
        color: inherit;
        padding: var(--space-1) var(--space-2);
        min-height: var(--touch-target);
      }
    </style>
  </body>
</html>
