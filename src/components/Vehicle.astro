---
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const numbers = getRaw<{ label: string; value: string }[]>(locale, 'home.numbers.items');

// Not translatable content, so kept alongside the markup rather than in i18n JSON.
// Order matches home.numbers.items: payload, load space, euro-pallets, response time.
const numberIcons = [
  'M6 7v10M18 7v10M2 10v4M22 10v4M6 12h12', // dumbbell — payload
  'M21 8 12 3 3 8v8l9 5 9-5V8Z|M3 8l9 5 9-5|M12 13v8', // cube — load space
  'M12 2 2 7l10 5 10-5-10-5Z|m2 12 10 5 10-5|m2 17 10 5 10-5', // layers — euro-pallets
  'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-15v5l3.5 2', // clock — response time
];
---

<section id="fahrzeug" class="vehicle section" data-reveal="right">
  <div class="container">
    <h2>{t('home.numbers.title')}</h2>
    <p class="vehicle-subtitle muted">{t('home.numbers.subtitle')}</p>
    <div class="numbers-strip">
      {
        numbers.map((item, i) => (
          <div class="numbers-cell">
            <svg class="numbers-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {numberIcons[i].split('|').map((d) => <path d={d} />)}
            </svg>
            <p class="figure numbers-value">{item.value}</p>
            <p class="numbers-label muted">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vehicle-subtitle {
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .numbers-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    overflow: hidden;
  }

  .numbers-cell {
    background: var(--color-surface);
    padding: var(--space-4);
    text-align: center;
  }

  .numbers-icon {
    width: 24px;
    height: 24px;
    color: var(--color-accent-1);
    margin-inline: auto;
    margin-bottom: var(--space-2);
  }

  .numbers-value {
    font-size: var(--text-figure);
    margin: 0 0 var(--space-1);
  }

  .numbers-label {
    font-size: var(--text-small);
    margin: 0;
  }

  @media (max-width: 720px) {
    .numbers-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
