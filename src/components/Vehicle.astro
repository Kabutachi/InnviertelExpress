---
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const numbers = getRaw<{ label: string; value: string }[]>(locale, 'home.numbers.items');
---

<section id="fahrzeug" class="vehicle section">
  <div class="container">
    <h2>{t('home.numbers.title')}</h2>
    <p class="vehicle-subtitle muted">{t('home.numbers.subtitle')}</p>
    <div class="numbers-strip">
      {
        numbers.map((item) => (
          <div class="numbers-cell">
            <p class="figure numbers-value">{item.value}</p>
            <p class="numbers-label muted">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vehicle-subtitle {
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .numbers-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    overflow: hidden;
  }

  .numbers-cell {
    background: var(--color-surface);
    padding: var(--space-4);
    text-align: center;
  }

  .numbers-value {
    font-size: var(--text-figure);
    margin: 0 0 var(--space-1);
  }

  .numbers-label {
    font-size: var(--text-small);
    margin: 0;
  }

  @media (max-width: 720px) {
    .numbers-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
