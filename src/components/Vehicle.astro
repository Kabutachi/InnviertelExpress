---
import { Image } from 'astro:assets';
import bayRear from '../assets/cargo-bay-day.png';
import baySide from '../assets/cargo-bay-day-2.png';
import vanSide from '../assets/van-side.png';
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const numbers = getRaw<{ label: string; value: string }[]>(locale, 'home.numbers.items');
const photoAlts = getRaw<string[]>(locale, 'home.numbers.photoAlts');
const photos = [bayRear, baySide, vanSide];

// Not translatable content, so kept alongside the markup rather than in i18n JSON.
// Order matches home.numbers.items: payload, load space, euro-pallets, response time.
const numberIcons = [
  'M6 7v10M18 7v10M2 10v4M22 10v4M6 12h12', // dumbbell — payload
  'M21 8 12 3 3 8v8l9 5 9-5V8Z|M3 8l9 5 9-5|M12 13v8', // cube — load space
  'M12 2 2 7l10 5 10-5-10-5Z|m2 12 10 5 10-5|m2 17 10 5 10-5', // layers — euro-pallets
  'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-15v5l3.5 2', // clock — response time
];
---

<section id="fahrzeug" class="vehicle section" data-reveal="right">
  <div class="container">
    <div class="vehicle-grid">
      <div class="bay-carousel" data-carousel>
        <div class="carousel-viewport">
          <ul class="carousel-track" data-track>
            {
              photos.map((photo, i) => (
                <li class="carousel-slide">
                  <figure class="bay">
                    <Image
                      src={photo}
                      alt={photoAlts[i]}
                      widths={[380, 560, 760, 1085]}
                      sizes="(min-width: 1000px) 34vw, (min-width: 640px) 60vw, 92vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  </figure>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="carousel-dots" data-dots>
          {
            photos.map((_, i) => (
              <button type="button" class="carousel-dot" data-dot={i} aria-label={photoAlts[i]} aria-current={i === 0 ? 'true' : 'false'} />
            ))
          }
        </div>
      </div>

      <div class="vehicle-copy">
        <h2>{t('home.numbers.title')}</h2>
        <p class="vehicle-subtitle muted">{t('home.numbers.subtitle')}</p>
        <div class="numbers-strip">
          {
            numbers.map((item, i) => (
              <div class="numbers-cell">
                <svg class="numbers-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {numberIcons[i].split('|').map((d) => <path d={d} />)}
                </svg>
                <p class="figure numbers-value">{item.value}</p>
                <p class="numbers-label muted">{item.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 4000;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || dots.length === 0) return;

    const count = dots.length;
    let index = 0;
    let timer: number | undefined;

    const apply = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false'));
    };

    const go = (next: number) => {
      index = (next + count) % count;
      apply();
    };

    const start = () => {
      if (reduceMotion.matches || timer !== undefined) return;
      timer = window.setInterval(() => go(index + 1), INTERVAL);
    };

    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        go(i);
        stop();
        start();
      })
    );

    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));

    apply();
    start();
  });
</script>

<style>
  .vehicle-grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .bay-carousel {
    position: relative;
  }

  .carousel-viewport {
    overflow: hidden;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
  }

  .carousel-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .bay {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .bay :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .carousel-dot {
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    border: none;
    background: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-border);
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .carousel-dot:hover::before {
    background: var(--color-text-muted);
  }

  .carousel-dot[aria-current='true']::before {
    background: var(--gradient-speed);
    transform: scale(1.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }

  .vehicle-subtitle {
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .numbers-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    overflow: hidden;
  }

  .numbers-cell {
    background: var(--color-surface);
    padding: var(--space-4);
    text-align: center;
  }

  .numbers-icon {
    width: 24px;
    height: 24px;
    color: var(--color-accent-1);
    margin-inline: auto;
    margin-bottom: var(--space-2);
  }

  .numbers-value {
    font-size: var(--text-figure);
    margin: 0 0 var(--space-1);
  }

  .numbers-label {
    font-size: var(--text-small);
    margin: 0;
  }

  @media (min-width: 1000px) {
    .vehicle-grid {
      grid-template-columns: 0.85fr 1fr;
      gap: var(--space-6);
    }

    .numbers-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
