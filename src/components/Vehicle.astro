---
import { Image } from 'astro:assets';
import bayRear from '../assets/cargo-bay-day.png';
import baySide from '../assets/cargo-bay-day-2.png';
import vanSide from '../assets/van-side.png';
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const photos = [bayRear, baySide, vanSide];
const photoAlts = getRaw<string[]>(locale, 'home.numbers.photoAlts');
const photoSizes = ['(min-width: 720px) 58vw, 92vw', '(min-width: 720px) 38vw, 92vw', '(min-width: 720px) 38vw, 92vw'];

const specs = getRaw<{ label: string; value: string }[]>(locale, 'home.numbers.items').map((item) => {
  const [figure, unit = ''] = item.value.split(' ');
  return { label: item.label, figure, unit, decimals: figure.includes(',') ? 1 : 0, count: figure.replace(',', '.') };
});
---

<section id="fahrzeug" class="van">
  <div class="container" data-reveal="right">
    <h2 class="van-h2">{t('home.numbers.subtitle')}</h2>

    <dl class="van-specs" data-van-specs>
      {
        specs.map((spec) => (
          <div class="van-spec">
            <dt>{spec.label}</dt>
            <dd>
              <span data-count={spec.count} data-dec={spec.decimals}>{spec.figure}</span>{spec.unit && <small>{spec.unit}</small>}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="van-shots">
      {
        photos.map((photo, i) => (
          <figure class="van-photo">
            <Image src={photo} alt={photoAlts[i]} widths={[480, 760, 960]} sizes={photoSizes[i]} loading="lazy" />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const specs = document.querySelector<HTMLElement>('[data-van-specs]');

  const count = (el: HTMLElement) => {
    const end = Number(el.dataset.count);
    const decimals = Number(el.dataset.dec ?? 0);
    const duration = 900;
    let start = 0;
    const step = (now: number) => {
      if (!start) start = now;
      const p = Math.min((now - start) / duration, 1);
      el.textContent = (end * (1 - Math.pow(1 - p, 3))).toFixed(decimals).replace('.', ',');
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (specs && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(specs);
  }
</script>

<style>
  .van {
    --van-bg: #f5f2ea;
    --van-ink: #191511;
    --van-muted: #71685a;
    --van-border: #dfd7c7;
    --van-red: #c22410;
    --van-r2: 10px;
    --van-hard: 4px 4px 0 rgba(25, 21, 17, 0.12);

    border-bottom: 1px solid var(--van-border);
    padding: 72px 0;
  }

  .van-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--van-ink);
    font-size: clamp(34px, 5.2vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.005em;
    margin: 14px 0 0;
    text-wrap: balance;
  }

  .van-specs {
    display: grid;
    grid-template-columns: 1fr;
    margin: 32px 0 0;
    border: 1px solid var(--van-ink);
    border-radius: var(--van-r2);
    overflow: hidden;
    background: var(--van-bg);
  }

  .van-spec {
    padding: 18px 18px 16px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .van-spec + .van-spec {
    border-top: 1px solid var(--van-ink);
  }

  .van-spec dt {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--van-muted);
  }

  .van-spec dd {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--van-ink);
    font-size: clamp(40px, 10vw, 76px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .van-spec dd small {
    font-size: 0.36em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--van-red);
  }

  .van-shots {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .van-photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--van-border);
    border-radius: var(--van-r2);
    background-color: #e9e2d3;
    background-image: repeating-linear-gradient(135deg, rgba(25, 21, 17, 0.045) 0 2px, transparent 2px 16px);
    box-shadow: var(--van-hard);
    min-height: 230px;
  }

  .van-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 720px) {
    .van {
      padding: 104px 0;
    }

    .van-specs {
      grid-template-columns: repeat(3, 1fr);
    }

    .van-spec {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 24px 24px 26px;
    }

    .van-spec + .van-spec {
      border-top: 0;
      border-left: 1px solid var(--van-ink);
    }

    .van-shots {
      grid-template-columns: 1.5fr 1fr;
      grid-template-rows: 1fr 1fr;
    }

    .van-shots .van-photo:first-child {
      grid-row: 1 / span 2;
      min-height: 480px;
    }
  }
</style>
