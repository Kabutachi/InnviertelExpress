---
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const items = getRaw<{ quote: string; name: string; role: string }[]>(locale, 'home.testimonials.items');
---

<section id="referenzen" class="testimonials section">
  <div class="container">
    <h2>{t('home.testimonials.title')}</h2>

    <div class="carousel" data-carousel>
      <div class="carousel-viewport">
        <ul class="carousel-track" data-track>
          {
            items.map((item) => (
              <li class="carousel-slide">
                <figure class="testimonial-card">
                  <blockquote>&ldquo;{item.quote}&rdquo;</blockquote>
                  <figcaption>
                    <span class="testimonial-name">{item.name}</span>
                    <span class="testimonial-role muted">{item.role}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="carousel-dots" data-dots>
        {
          items.map((item, i) => (
            <button
              type="button"
              class="carousel-dot"
              data-dot={i}
              aria-label={item.name}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 3000;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || dots.length === 0) return;

    const count = dots.length;
    let index = 0;
    let timer: number | undefined;

    const apply = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false'));
    };

    const go = (next: number) => {
      index = (next + count) % count;
      apply();
    };

    const start = () => {
      if (reduceMotion.matches || timer !== undefined) return;
      timer = window.setInterval(() => go(index + 1), INTERVAL);
    };

    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        go(i);
        stop();
        start();
      })
    );

    // Pause while the visitor is reading (hover or keyboard focus), resume after.
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    // Don't advance while the tab is hidden.
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));

    apply();
    start();
  });
</script>

<style>
  .carousel {
    margin-top: var(--space-4);
  }

  .carousel-viewport {
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
    padding-block: var(--space-2);
    display: flex;
    justify-content: center;
  }

  .testimonial-card {
    width: 100%;
    max-width: 46rem;
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    padding: var(--space-5);
  }

  .testimonial-card blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.3;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .testimonial-card blockquote::before {
    content: '';
    display: block;
    width: 32px;
    height: 5px;
    background: var(--gradient-speed);
    margin-bottom: var(--space-3);
  }

  .testimonial-card figcaption {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .testimonial-name {
    font-weight: 700;
    color: var(--color-ink);
  }

  .testimonial-role {
    font-size: var(--text-small);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .carousel-dot {
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    border: none;
    background: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-border);
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .carousel-dot:hover::before {
    background: var(--color-text-muted);
  }

  .carousel-dot[aria-current='true']::before {
    background: var(--gradient-speed);
    transform: scale(1.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>
