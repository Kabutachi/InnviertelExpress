---
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const trustItems = getRaw<{ title: string; text: string }[]>(locale, 'home.trust.items');
---

<section class="trust-block section">
  <div class="container">
    <h2 class="trust-title">{t('home.trust.title')}</h2>
  </div>

  <div class="trust-scroller container">
    {
      trustItems.map((item) => (
        <article class="trust-card">
          <div class="trust-tick" aria-hidden="true" />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .trust-scroller {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-bottom: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    -webkit-overflow-scrolling: touch;
  }

  .trust-card {
    flex: 0 0 clamp(15rem, 70vw, 19rem);
    scroll-snap-align: start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    padding: var(--space-4);
  }

  .trust-card p {
    margin-top: var(--space-2);
  }

  .trust-tick {
    width: 24px;
    height: 4px;
    background: var(--gradient-speed);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 900px) {
    .trust-scroller {
      overflow-x: visible;
    }

    .trust-card {
      flex: 1;
    }
  }
</style>
