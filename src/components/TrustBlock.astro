---
import { getT, getRaw, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const trustItems = getRaw<{ title: string; text: string }[]>(locale, 'home.trust.items');

// Not translatable content, so kept alongside the markup rather than in i18n JSON.
// Order matches home.trust.items: direct line to the driver, pickup in hours, nights/weekends, custom loads.
const trustIcons = [
  'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z', // chat bubble — direct line
  'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-15v5l3.5 2', // clock — pickup in hours
  'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z', // moon — nights and weekends
  'M4 21v-7|M4 10V3|M12 21v-9|M12 8V3|M20 21v-5|M20 12V3|M1 14h6|M9 8h6|M17 16h6', // sliders — custom
];
---

<section class="trust-block section" data-reveal="left">
  <video class="trust-video" src="/video/night-drive.mp4" poster="/video/night-drive-poster.webp" preload="none" muted playsinline aria-hidden="true" tabindex="-1"></video>
  <div class="container">
    <h2 class="trust-title">{t('home.trust.title')}</h2>
  </div>

  <div class="trust-scroller container">
    {
      trustItems.map((item, i) => (
        <article class="trust-card">
          <div class="trust-tick" aria-hidden="true" />
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {trustIcons[i].split('|').map((d) => <path d={d} />)}
          </svg>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .trust-block {
    position: relative;
    overflow: hidden;
  }

  .trust-block .container {
    position: relative;
  }

  .trust-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.48;
    filter: blur(1px);
    transform: scale(1.04);
    pointer-events: none;
  }

  .trust-scroller {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-bottom: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    -webkit-overflow-scrolling: touch;
  }

  .trust-card {
    flex: 0 0 clamp(15rem, 70vw, 19rem);
    scroll-snap-align: start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-crate);
    padding: var(--space-4);
  }

  .trust-card p {
    margin-top: var(--space-2);
  }

  .trust-tick {
    width: 24px;
    height: 4px;
    background: var(--gradient-speed);
    margin-bottom: var(--space-3);
  }

  .trust-icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent-1);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 900px) {
    .trust-scroller {
      overflow-x: visible;
    }

    .trust-card {
      flex: 1;
    }
  }
</style>
