---
import { getT, locales, localizePath, type Locale, type PageId } from '../i18n/config';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = getT(locale);

const nativeNames: Record<Locale, string> = {
  de: 'Deutsch',
  en: 'English',
  ru: 'Русский',
  uk: 'Українська',
};
---

<nav class="language-switcher" aria-label={t('common.languageSwitcherLabel')}>
  {
    locales.map((l) => (
      <a
        href={localizePath(l, page)}
        lang={l}
        hreflang={l}
        data-locale-choice={l}
        aria-current={l === locale ? 'page' : undefined}
        aria-label={nativeNames[l]}
        class:list={['language-switcher-item', { active: l === locale }]}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .language-switcher {
    display: flex;
    gap: var(--space-1);
  }

  .language-switcher-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: var(--touch-target);
    padding-inline: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    position: relative;
  }

  .language-switcher-item:hover {
    color: var(--color-ink);
  }

  .language-switcher-item.active {
    color: var(--color-ink);
    font-weight: 700;
  }

  .language-switcher-item.active::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 6px;
    width: 1.25rem;
    height: 3px;
    background: var(--gradient-speed);
  }
</style>
